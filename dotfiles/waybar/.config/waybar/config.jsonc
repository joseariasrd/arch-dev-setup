{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "custom/gpu", "pulseaudio", "network", "tray"],

  "hyprland/workspaces": { "format": "{id}", "on-click": "activate" },
  "hyprland/window": { "max-length": 60, "separate-outputs": true },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": { "format": " {usage}%", "interval": 3 },
  "memory": { "format": " {used:0.1f}G", "interval": 5 },
  "custom/gpu": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits | awk -F', ' '{print \"󰢮 \" $1 \"% \" $2 \"°\"}'",
    "interval": 5
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "pavucontrol"
  },
  "network": {
    "format-ethernet": "󰈀 {ipaddr}",
    "format-wifi": " {essid}",
    "format-disconnected": "󰖪 offline",
    "on-click": "kitty nmtui"
  },
  "tray": { "spacing": 8 }
}
